{
  "name": "atlas-world-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node build.mjs && node server.mjs",
    "build": "node build.mjs && node prepare-cloudflare.mjs",
    "test": "node build.mjs && node prepare-cloudflare.mjs && node --test --experimental-test-isolation=none handler.test.mjs source.test.mjs build.test.mjs dev.test.mjs urls.test.mjs pages.test.mjs",
    "deploy": "node build.mjs && node prepare-cloudflare.mjs && wrangler deploy",
    "test:browser": "playwright test",
    "build:pages": "node build-pages.mjs",
    "preview:pages": "vite preview --mode pages"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.5",
    "clipper-lib": "6.4.2",
    "earcut": "3.2.4",
    "maplibre-gl": "5.24.1",
    "pbf": "4.0.2",
    "polygon-clipping": "0.15.7",
    "straight-skeleton": "3.0.0",
    "suncalc": "1.9.0",
    "three": "0.187.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
